# ===== Copy file này thành .env rồi điền =====

# Cổng chạy web
PORT=3000

# Địa chỉ web khi chạy thật (để ghi link video vào Lark). Ví dụ: https://video.haireoto.com
APP_PUBLIC_URL=http://localhost:3000

# Mật khẩu vào web (để trống = ai có link cũng vào được). Tên đăng nhập gõ gì cũng được.
APP_PASSWORD=

# ===== Lark Base =====
# Tạo app trong Lark Developer (open.larksuite.com) -> lấy App ID, App Secret
# Cấp quyền: bitable (đọc/ghi), rồi thêm app vào base bằng nút "..." > "Add document app" (Thêm ứng dụng tài liệu).
LARK_APP_ID=
LARK_APP_SECRET=
# Base "HAI RÊ Video Studio" (đã tạo sẵn, tên hiện còn là Untitled base)
LARK_BASE_TOKEN=T6Zsbsa8famZ6jsWjWjjmtsFpad
LARK_API_BASE=https://open.larksuite.com

# ===== AI (nghiên cứu xu hướng, viết định hướng quay) =====
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ===== Dựng video =====
# Nếu máy có Whisper (pip install openai-whisper) thì phụ đề tiếng Việt tự động bật được
WHISPER_MODEL=small
