# ==========================================================
# Sao chép file này thành .env rồi điền thông tin của bạn:
#     cp .env.example .env
#     nano .env
# ==========================================================

# Tên miền trỏ về VPS (bắt buộc, để có HTTPS cho micro hoạt động)
DOMAIN=thayai.ten-mien-cua-ban.com

# Mã PIN để vào app (4 số)
PIN=1234

# Khóa Claude (Anthropic) — lấy tại https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Khóa Grok (xAI) — lấy tại https://console.x.ai
XAI_API_KEY=xai-...

# ----- Phần dưới để mặc định cũng được -----
# Mô hình Claude cho các thầy (có thể ghi đè trong từng file thầy)
CLAUDE_MODEL=claude-opus-5-5
# Mô hình ghi sổ ghi nhớ (rẻ, nhanh)
MEMORY_MODEL=claude-haiku-5-5
# Mô hình giọng nói của Grok
GROK_VOICE_MODEL=grok-voice-latest
